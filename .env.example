# Arc backend/indexer
ARC_CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_RPC_FALLBACKS=
ARC_WS_URL=
ARC_POLLING_INTERVAL_MS=30000
LOG_CHUNK_SIZE=5
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
PRIVATE_KEY=

# Arc chain analytics (server-side only)
# Create/manage the key at https://dev.blockscout.com/dashboard
BLOCKSCOUT_API_KEY=
BLOCKSCOUT_API_BASE_URL=https://api.blockscout.com
# Keep Arc network analytics on mainnet even if the Supershot app itself is running on testnet.
ARC_ANALYTICS_CHAIN_ID=5042
ARC_EXPLORER_URL=https://explorer.arc.io

# Web
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_FALLBACKS=
NEXT_PUBLIC_ARC_WALLET_RPC_URL=
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arc-scan.org
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Legacy V1 addresses are optional on Arc Mainnet. Leave blank for a Celestial-only mainnet deployment.
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_FEE_ESCROW_ADDRESS=
NEXT_PUBLIC_CELESTIAL_FACTORY_ADDRESS=
NEXT_PUBLIC_CELESTIAL_FEE_ESCROW_ADDRESS=
NEXT_PUBLIC_CELESTIAL_BUYBACK_VAULT_ADDRESS=
NEXT_PUBLIC_CELESTIAL_LIQUIDITY_LOCKER_ADDRESS=
NEXT_PUBLIC_CELESTIAL_ORDERBOOK_ADDRESS=
NEXT_PUBLIC_CELESTIAL_DEX_ADAPTER_ADDRESS=
NEXT_PUBLIC_API_URL=

# Data
DATABASE_URL=
# Keep testnet on public. Arc mainnet (chain 5042) must use an isolated schema such as mainnet.
DATABASE_SCHEMA=public
# Legacy V1 indexer inputs. Leave blank for a Celestial-only Arc Mainnet indexer.
FACTORY_ADDRESS=
FACTORY_START_BLOCK=
CELESTIAL_FACTORY_ADDRESS=
CELESTIAL_FACTORY_START_BLOCK=
ORDERBOOK_ADDRESS=
BUYBACK_VAULT_ADDRESS=

# Post-graduation Uniswap v4 indexing
CELESTIAL_DEX_ADAPTER_ADDRESS=
CELESTIAL_DEX_CONNECTOR_ADDRESS=

# Populate only from official Arc Uniswap deployment sources
UNISWAP_V4_POOL_MANAGER=
UNISWAP_V4_POSITION_MANAGER=
UNISWAP_V4_QUOTER=
UNISWAP_UNIVERSAL_ROUTER=
UNISWAP_PERMIT2=
CELESTIAL_V4_LP_FEE=3000

