{
  "name": "supershot-fun",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @arc-launchpad/web run dev",
    "build:web": "npm --workspace @arc-launchpad/web run build",
    "dev:indexer": "npm --workspace @arc-launchpad/indexer run dev",
    "build:indexer": "npm --workspace @arc-launchpad/indexer run build",
    "dev:api": "npm --workspace @arc-launchpad/api run dev",
    "build:api": "npm --workspace @arc-launchpad/api run build",
    "build": "npm run build:indexer && npm run build:api && npm run build:web"
  }
}
